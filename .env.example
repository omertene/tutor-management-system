# Copy this file to .env (or set these as real environment variables) and fill in real values
# Spring Boot does NOT read .env files automatically - either export these as real
# OS/IDE environment variables, or configure your run tool (e.g. an IntelliJ EnvFile
# plugin) to load this file. application.properties has no fallback for the values
# below marked required - the app will refuse to start without them.

DB_USERNAME=postgres
DB_PASSWORD=changeme          # required

# generate with: openssl rand -base64 64
JWT_SECRET=changeme           # required

TEACHER_SEED_EMAIL=teacher@example.com
TEACHER_SEED_PASSWORD=changeme # required

# gmail SMTP - used to send lesson reminder emails
MAIL_USERNAME=changeme@gmail.com # required
# 16-character Gmail "app password"
MAIL_PASSWORD=changeme         # required

# --- deployment ---
# JDBC url of the hosted Postgres (e.g. Neon): jdbc:postgresql://HOST/DBNAME?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/tutor_db
# comma-separated frontend URL(s) allowed by CORS, no trailing slash
CORS_ALLOWED_ORIGINS=http://localhost:5173

# email over HTTPS via Brevo (needed on hosts that block SMTP, e.g. Render free)
BREVO_API_KEY=changeme
BREVO_SENDER_EMAIL=your-verified-sender@gmail.com

# showcase mode (default false). true = "Try demo" signs anyone in as the teacher, no password.
# only ever true on a site that holds fake data
DEMO_ENABLED=false
