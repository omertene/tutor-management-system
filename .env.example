# Copy this file to .env (or set these as real environment variables) and fill in
# real values before running this app anywhere other than your own machine.
# application.properties falls back to insecure local-dev defaults if these aren't set -
# that's fine for local development, but never rely on those defaults elsewhere.

DB_USERNAME=postgres
DB_PASSWORD=changeme

# generate with: openssl rand -base64 64
JWT_SECRET=changeme

TEACHER_SEED_EMAIL=teacher@example.com
TEACHER_SEED_PASSWORD=changeme
